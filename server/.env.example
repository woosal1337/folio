# Folio server configuration. All variables are prefixed FOLIO_.
# Copy to .env and edit. Never commit a real .env.

# --- security ---
# Sign JWTs with this. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
FOLIO_JWT_SECRET=change-me-in-production
FOLIO_ACCESS_TOKEN_TTL_MINUTES=30
FOLIO_REFRESH_TOKEN_TTL_DAYS=30
FOLIO_ALLOW_REGISTRATION=true

# --- database ---
# SQLite (default, zero-config, single node):
FOLIO_DATABASE_URL=sqlite+aiosqlite:///./data/folio.db
# Postgres (production / multi-worker):
# FOLIO_DATABASE_URL=postgresql+asyncpg://folio:folio@db:5432/folio

# --- storage ---
FOLIO_STORAGE_BACKEND=local
FOLIO_STORAGE_DIR=./data/blobs
FOLIO_MAX_UPLOAD_BYTES=2147483648

# --- transcription ---
# engine: auto (faster-whisper if installed, else stub) | faster_whisper | stub
FOLIO_WHISPER_ENGINE=auto
FOLIO_WHISPER_MODEL=base
# device: auto | cpu | cuda
FOLIO_WHISPER_DEVICE=auto
# compute_type: auto | int8 | int8_float16 | float16 | float32
FOLIO_WHISPER_COMPUTE_TYPE=auto
FOLIO_DIARIZATION_ENABLED=false

# --- worker ---
FOLIO_WORKER_POLL_INTERVAL_SECONDS=2.0
FOLIO_RUN_WORKER_IN_PROCESS=false

# --- http ---
FOLIO_CORS_ORIGINS=*
FOLIO_ENVIRONMENT=development
