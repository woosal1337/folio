{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted ONLY to the main app window. Captions, preferences, editor, library, and record windows each carry their own capability file so the surface stays minimum-per-class per docs/CODE_STYLE.md §8.4. Removed in this revision: the recursive $HOME fs:* grants (writes funnel through canonicalised Tauri commands; raw filesystem access was unjustified) and the blanket https://* / http://* opener allow (replaced with an explicit per-host allowlist).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:webview:default",
    "core:app:default",
    "dialog:default",
    "fs:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://api.openai.com/*" },
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://huggingface.co/*" },
        { "url": "https://github.com/woosal1337/*" },
        { "url": "https://folio.app/*" },
        { "url": "mailto:*" },
        { "url": "obsidian://*" },
        { "url": "folio://*" },
        { "url": "x-apple.systempreferences:*" }
      ]
    }
  ]
}
