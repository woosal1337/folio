{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "secondary",
  "description": "Secondary record/library/editor windows (Cmd-N / Cmd-Shift-L / row-double-click). Mirrors the main window's command surface so multi-window flows work, but the home-recursive fs grants are dropped — disk writes funnel through canonicalised Tauri commands.",
  "windows": ["record-*", "library-standalone", "editor-*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:webview:default",
    "core:app:default",
    "dialog:default",
    "fs:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://api.openai.com/*" },
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://huggingface.co/*" },
        { "url": "https://github.com/woosal1337/*" },
        { "url": "https://attune.app/*" },
        { "url": "mailto:*" },
        { "url": "obsidian://*" },
        { "url": "attune://*" },
        { "url": "x-apple.systempreferences:*" }
      ]
    }
  ]
}
