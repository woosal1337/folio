{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "preferences",
  "description": "Preferences NSWindow — Cmd-, surface. Reads + writes settings via Tauri commands (state.settings, KeyStore). No fs:* needed because every persisted setting goes through canonicalised commands.",
  "windows": ["preferences"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/woosal1337/*" },
        { "url": "https://folio.app/*" },
        { "url": "mailto:*" },
        { "url": "x-apple.systempreferences:*" }
      ]
    }
  ]
}
