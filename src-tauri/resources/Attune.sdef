<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<!--
  Attune AppleScript / JXA dictionary. v2 roadmap finding 080 / GET-102.

  Bundle this file at Contents/Resources/Attune.sdef and add an
  OSAScriptingDefinition + NSAppleScriptEnabled YES entry to
  Info.plist so Keyboard Maestro / BetterTouchTool / Hammerspoon /
  Alfred / Automator can script the app. Every verb routes through
  the same attune:// URL scheme + .attune/inbox JSON contract that
  the shortcuts integration uses, so behavior stays consistent
  across every entry point.
-->
<dictionary title="Attune Terminology">
  <suite name="Attune Suite" code="Attu" description="Attune-specific verbs.">

    <command name="start recording" code="AttustaR" description="Begin a new recording session.">
      <cocoa class="AttuneScriptStartRecording"/>
    </command>

    <command name="stop recording" code="AttustoR" description="Stop the in-progress recording and (optionally) auto-transcribe.">
      <cocoa class="AttuneScriptStopRecording"/>
      <parameter name="and summarize" code="suma" type="boolean" optional="yes" description="When true, fires the Summarize agent after the transcript lands.">
        <cocoa key="andSummarize"/>
      </parameter>
    </command>

    <command name="add task" code="AttuaddT" description="Drop a task onto the kanban inbox column.">
      <cocoa class="AttuneScriptAddTask"/>
      <parameter name="title" code="titl" type="text" description="Task title.">
        <cocoa key="title"/>
      </parameter>
      <parameter name="owner" code="ownr" type="text" optional="yes" description="Free-form owner string ('@alice', 'design team', …).">
        <cocoa key="owner"/>
      </parameter>
      <parameter name="due" code="duee" type="text" optional="yes" description="Free-form due-date string ('Friday', 'next sprint', '2026-06-01').">
        <cocoa key="due"/>
      </parameter>
    </command>

    <command name="search memory" code="AttusrcM" description="Substring search over the on-disk memory markdown files; returns one result per match.">
      <cocoa class="AttuneScriptSearchMemory"/>
      <parameter name="query" code="qery" type="text" description="Substring to match against memory content + key.">
        <cocoa key="query"/>
      </parameter>
      <parameter name="kind" code="kind" type="text" optional="yes" description="Restrict by memory kind (observe / claim / pref / person).">
        <cocoa key="kind"/>
      </parameter>
      <result type="text" description="JSON-encoded list of matches; one object per memory."/>
    </command>

    <command name="last meeting summary" code="AttulstS" description="Return the summarize-agent result for the most recent recording.">
      <cocoa class="AttuneScriptLastMeetingSummary"/>
      <result type="text" description="Markdown summary, or an empty string when no summary exists."/>
    </command>

    <command name="open url" code="AttuopnU" description="Open an attune:// URL inside the running app (matches the dock-icon drop path).">
      <cocoa class="AttuneScriptOpenURL"/>
      <parameter name="url" code="url " type="text" description="The attune:// URL to dispatch.">
        <cocoa key="url"/>
      </parameter>
    </command>

  </suite>
</dictionary>
