{
  "name": "folio",
  "private": true,
  "version": "1.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:motion": "node scripts/check-motion.mjs",
    "lint:fix": "eslint src --max-warnings 0 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:fixtures": "node scripts/generate-voice-fixtures.mjs",
    "test:transcription": "cargo test -p folio-core --test transcription_fixtures --release -- --ignored --nocapture",
    "icon:rasterize": "node scripts/rasterize-icon.mjs",
    "icon:generate": "bun run icon:rasterize && bun tauri icon src-tauri/icons/logo-source.png"
  },
  "dependencies": {
