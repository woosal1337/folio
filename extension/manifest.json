{
  "manifest_version": 3,
  "name": "Attune meeting context",
  "version": "0.1.0",
  "description": "Pings the local Attune app via the attune:// URL scheme when you land on a Zoom / Google Meet / Microsoft Teams tab. No data ever leaves your machine — every payload goes straight to the local app.",
  "permissions": ["tabs", "activeTab"],
  "host_permissions": [
    "*://zoom.us/*",
    "*://*.zoom.us/*",
    "*://meet.google.com/*",
    "*://teams.microsoft.com/*",
    "*://*.teams.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Prepare Attune for this meeting",
    "default_icon": {
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  }
}
