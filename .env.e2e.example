# Template for the local e2e test secrets.
# Copy to `.env.e2e` (gitignored) and fill in your own keys.
#
#   cp .env.e2e.example .env.e2e
#
# The e2e suite uses ElevenLabs for one audio fixture. Provide your own
# key from https://elevenlabs.io/app/settings/api-keys — it is never
# committed and never leaves your machine.

ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
